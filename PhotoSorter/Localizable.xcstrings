        }
      }
    },
    "Photo Sorter forgets its results and your moves between piles. Ignored photos stay ignored." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo Sorter забудет результаты и ваши перемещения между стопками. Исключённые фото останутся исключёнными."
          }
        }
      }
    },
    "Photo Sorter loads its models." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo Sorter загружает модели."
          }
        }
      }
    },
    "Photo Sorter looks at every photo on this device and puts it on a pile. A photo goes to a cleanup pile only when the model sees no real photo in it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo Sorter просматривает каждое фото на этом устройстве и кладёт его в стопку. Фото попадает в стопку на очистку, только если модель не видит в нём настоящей фотографии."
          }
        }
      }
    },
    "Photo Sorter puts your library on piles: screenshots, memes, documents, graphics and real photos." : {
      "extractionState" : "manual",
